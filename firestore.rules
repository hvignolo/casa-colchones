rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquier usuario autenticado con Firebase Auth (el administrador del panel).
    function isSignedIn() {
      return request.auth != null;
    }

    // Productos: lectura pública (catálogo), escritura solo autenticado.
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Pedidos: cualquiera puede crear (clientes), el resto solo autenticado.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Configuración de la tienda: lectura pública, escritura solo autenticado.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Ventas de contado: datos internos, solo autenticado.
    match /cash_sales/{saleId} {
      allow read, write: if isSignedIn();
    }

    // Cuentas personales (ventas en cuotas): datos internos, solo autenticado.
    match /personal_accounts/{accountId} {
      allow read, write: if isSignedIn();
    }
  }
}
