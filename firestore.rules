rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "bautinapuntadas@gmail.com";
    }

    // Products: Public read, Admin write
    // If you add real Firebase Auth later, change write to isAdmin()
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Temporarily open for the app to function without valid Firebase Auth token
    }

    // Orders: Anyone can create
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if true; // Temporarily open
    }

    // Settings: Public read
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true; // Temporarily open
    }

    // Personal Accounts
    // Changed to public access because the app uses local auth (AuthContext) 
    // instead of real Firebase Auth, so request.auth is null.
    match /personal_accounts/{accountId} {
      allow read, write: if true;
    }
  }
}
